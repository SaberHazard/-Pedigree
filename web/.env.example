# ==========================================================================
#  تنظیمات شجره‌نامه - این فایل را به .env کپی کنید و مقادیر را تغییر دهید
# ==========================================================================

APP_NAME="Pedigree"
APP_ENV=production
APP_KEY=
# در محیط واقعی حتماً false باشد
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- پایگاه داده (پیشنهاد: MySQL 8 یا MariaDB 10.6+) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pedigree
DB_USERNAME=pedigree
DB_PASSWORD=

# --- سشن امن ---
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# روی HTTPS حتماً true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# دامنه(های) وب‌اپ برای ورود کوکی‌محور (بدون http://)
SANCTUM_STATEFUL_DOMAINS=example.com,www.example.com

# اگر پشت CDN/پروکسی هستید (ابرآروان، Cloudflare): آدرس پروکسی‌ها یا *
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# --- تنظیمات شجره‌نامه ---
PEDIGREE_SITE_NAME="شجره‌نامه خانوادگی"
# کلید ایندکس جستجوی اطلاعات رمزنگاری‌شده (یک رشته تصادفی ۶۴ کاراکتری؛ بعداً تغییر ندهید)
PEDIGREE_BLIND_INDEX_KEY=
# ثبت‌نام آزاد با شماره موبایل
PEDIGREE_REGISTRATION=true
# مشاهده درخت بدون ورود
PEDIGREE_GUEST_VIEW=false
PEDIGREE_OTP_LENGTH=6
PEDIGREE_OTP_TTL=120
# اگر supervisor ندارید true بماند (صف با cron اجرا می‌شود)
PEDIGREE_QUEUE_VIA_SCHEDULER=true
# اگر هیچ رأی‌دهنده‌ای نبود: admin یا approve
PEDIGREE_APPROVAL_FALLBACK=admin
# کد ملی هنگام ثبت‌نام اجباری باشد؛ و گزینه «کد ملی ایرانی ندارم» برای ساکنان خارج
PEDIGREE_REQUIRE_NATIONAL_CODE=true
PEDIGREE_ALLOW_NO_NATIONAL_CODE=true
# سازنده پروفایلی که بسته درجه یک نیست تا چند ساعت حق ویرایش دارد (۰ = همیشه)
PEDIGREE_CREATOR_EDIT_HOURS=72
# تاریخچه تغییرات پروفایل‌ها برای همه اعضا قابل دیدن باشد
PEDIGREE_HISTORY_PUBLIC=true

# --- نقشه (محل زندگی، آرامگاه، نقشه خاندان) ---
PEDIGREE_MAP_ENABLED=true
PEDIGREE_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PEDIGREE_MAP_ATTRIBUTION="© OpenStreetMap contributors"

# --- رسانه ---
PEDIGREE_MEDIA_DISK=media
PEDIGREE_IMAGE_MAX_KB=20480
PEDIGREE_VIDEO_ENABLED=true
PEDIGREE_VIDEO_MAX_KB=512000
# فشرده‌سازی مثل تلگرام: ضلع کوچک‌تر ویدیو (480/720/1080) و CRF (23 کیفیت بالا، 26 متعادل، 28 صرفه‌جویی)
PEDIGREE_VIDEO_MAX_SIDE=720
PEDIGREE_VIDEO_CRF=26
PEDIGREE_VIDEO_MAX_SECONDS=3600
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- عکس پروفایل شبکه‌های اجتماعی (تلگرام، اینستاگرام، گیت‌هاب) ---
PEDIGREE_SOCIAL_FETCH=true
# اگر سرور در ایران است و تلگرام/اینستاگرام در دسترس نیست: socks5h://127.0.0.1:1080 یا http://proxy:3128
PEDIGREE_SOCIAL_PROXY=
# سقف درخواست سرور به هر شبکه در ساعت
PEDIGREE_SOCIAL_HOURLY=300
# روش رسمی اینستاگرام (Business Discovery؛ فقط حساب‌های تجاری/تولیدکننده) — توکن Graph API و شناسه حساب تجاری خودتان
PEDIGREE_INSTAGRAM_TOKEN=
PEDIGREE_INSTAGRAM_USER_ID=
# اختیاری: عکس پروفایل ایکس و یوتیوب با کلید رسمی
PEDIGREE_X_BEARER_TOKEN=
PEDIGREE_YOUTUBE_API_KEY=
# سقف کل پیامک‌های روزانه (جلوگیری از خالی شدن اعتبار پنل)
PEDIGREE_OTP_GLOBAL_DAILY=2000

# --- پنل پیامکی: log | kavenegar | smsir | melipayamak | ippanel | ghasedak ---
# (همه این کلیدها از «پنل مدیریت ← تنظیمات و اتصال‌ها» هم قابل ورودند و مقدار پنل مقدم است)
SMS_DRIVER=log
# پنل پیامک‌های تبریک اعضا (خالی = همان پنل کد ورود)
SMS_MESSAGE_DRIVER=
# حداقل درصد تکمیل پروفایل فرستنده پیامک تبریک (پیامک تبریک و اعلان تولد قابل خاموش کردن نیست)
PEDIGREE_MEMBER_SMS_MIN_PROFILE=95

KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify
# خط ارسال پیامک عادی (خالی = خط پیش‌فرض حساب)
KAVENEGAR_SENDER=

SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAMETER=CODE
SMSIR_LINE_NUMBER=

MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_BODY_ID=
MELIPAYAMAK_FROM=

IPPANEL_API_KEY=
IPPANEL_SENDER=+983000505
IPPANEL_PATTERN_CODE=
IPPANEL_PATTERN_VARIABLE=code

GHASEDAK_API_KEY=
GHASEDAK_OTP_TEMPLATE=
GHASEDAK_LINE_NUMBER=

# --- دستیار هوش مصنوعی: gemini | openrouter | groq | openai | anthropic | custom ---
# (از «پنل مدیریت ← تنظیمات» هم قابل تنظیم است) رایگان‌ها: Gemini، OpenRouter (مدل‌های :free) و Groq
PEDIGREE_AI_ENABLED=true
PEDIGREE_AI_PROVIDER=gemini
# سرویس‌های خارجی IP ایران را نمی‌پذیرند؛ اگر سرور در ایران است (خالی = همان PEDIGREE_SOCIAL_PROXY)
PEDIGREE_AI_PROXY=
PEDIGREE_AI_DAILY_PER_USER=40
PEDIGREE_AI_GLOBAL_DAILY=2000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# هر سرویس سازگار با OpenAI (آدرسی که /chat/completions به انتهایش اضافه می‌شود)
PEDIGREE_AI_BASE_URL=
PEDIGREE_AI_API_KEY=
PEDIGREE_AI_MODEL=

# --- پیام‌رسان اعضا ---
# (فقط متن و ایموجی؛ سقف روزانه هر عضو در config/pedigree.php ← messaging.daily_limit)

# --- پوش‌نوتیفیکیشن اپ موبایل (اختیاری) ---
FCM_ENABLED=false
FCM_CREDENTIALS=
# یا محتوای فایل JSON (بهتر: از پنل مدیریت)
FCM_CREDENTIALS_JSON=

# --- فضای ابری S3 (اختیاری، مثلاً ابرآروان) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
