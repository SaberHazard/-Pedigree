<?xml version="1.0" encoding="utf-8"?>
<!--
  اپ هیچ داده‌ای در بکاپ ابری یا انتقال به گوشی جدید نمی‌برد؛
  کوکی نشست و توکن ورود فقط روی همین دستگاه معتبر است (امنیت حساب).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
