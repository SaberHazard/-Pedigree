<?xml version="1.0" encoding="utf-8"?>
<!-- نسخه انتشار: فقط HTTPS و فقط گواهی‌های سیستمی (بدون گواهی نصب‌شده توسط کاربر) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
