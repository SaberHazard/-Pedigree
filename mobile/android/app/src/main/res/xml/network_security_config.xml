<?xml version="1.0" encoding="utf-8"?>
<!-- فقط HTTPS مجاز است؛ به جز آدرس شبیه‌ساز برای توسعه محلی -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
